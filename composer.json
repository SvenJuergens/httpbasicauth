{
  "name": "svenjuergens/httpbasicauth",
  "description": "HTTP Basic Auth for TYPO3 via site configuration",
  "type": "typo3-cms-extension",
  "license": [
    "GPL-2.0-or-later"
  ],
  "keywords": [
    "authentication"
  ],
  "support": {
    "issues": "https://github.com/SvenJuergens/httpbasicauth/issues",
    "source": "https://github.com/SvenJuergens/httpbasicauth"
  },
  "authors": [
    {
      "name": "Christoph Lehmann",
      "email": "post@christophlehmann.eu"
    },
    {
      "name": "Sven Jürgens"
    }
  ],
  "require": {
    "php": ">=8.2",
    "typo3/cms-core": "^13.4 || ^14.3"
  },
  "replace": {
    "christophlehmann/httpbasicauth": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "httpbasicauth"
    }
  },
  "autoload": {
    "psr-4": {
      "Lemming\\Httpbasicauth\\": "Classes/"
    }
  }
}
